# Local disk mode: DATABASE_URL empty uses the real node:sqlite database.
# Load with: node --env-file=.env --import tsx server/index.ts
HOST=127.0.0.1
PORT=8787
DATABASE_URL=
SQLITE_PATH=./data/monitor.sqlite
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NOTIFICATION_URL=http://127.0.0.1:5173/
COLLECT_ON_START=true
COLLECTION_TIMEOUT_MS=55000
MAX_SUBSCRIPTIONS=1000

# Optional CMC key: server only. Never use a VITE_ prefix for secrets.
CMC_API_KEY=

# Browser push is disabled until all three values are configured.
# Generate one stable VAPID key pair; keep its private key on the server.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Docker Compose only: use a long random hexadecimal password (URL-safe).
# Set ALLOWED_ORIGINS to the exact deployed frontend origin, no trailing slash.
# Set NOTIFICATION_URL to the complete deployed frontend URL, including Pages path.
POSTGRES_PASSWORD=
